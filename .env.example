# Copy to .env.local and fill in locally. Never commit real values.
# Use the connection string from your Neon project, including sslmode=require.
DATABASE_URL=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional canonical public origin for a reverse proxy, e.g. https://forecast.example.org
# Exact origin only: no trailing slash, path, credentials, or query.
APP_ORIGIN=
# Optional, dedicated disposable Neon test database. Never use a production URL.
# The Node integration test reads this from the process environment, not .env.local.
AUTH_TEST_DATABASE_URL=
